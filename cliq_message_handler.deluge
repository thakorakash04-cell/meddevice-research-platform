// Paste into the Zoho Cliq bot's Message Handler.
// Replace the URL and API key. Keep the key private; prefer a Zoho Connection
// with an X-API-Key header for shared/production installations.
payload = Map();
payload.put("message", message);
// IDs keep each user's follow-up searches separate. No names/emails are sent.
if(user.get("id") != null && chat.get("id") != null)
{
    payload.put("user_id", user.get("id").toString());
    payload.put("chat_id", chat.get("id").toString());
}
headers = Map();
headers.put("Content-Type", "application/json");
headers.put("X-API-Key", "REPLACE_WITH_YOUR_SECRET_KEY");
response = Map();
try
{
    result = invokeurl
    [
        url : "https://YOUR_API_HOST/chat"
        type : POST
        body : payload.toString()
        headers : headers
        detailed : true
    ];
    code = result.get("responseCode");
    if(code == 401)
    {
        response.put("text", "Authentication failed (401). The X-API-Key in this handler must exactly match CLIQ_API_KEY in Render. This is not your Gemini key.");
    }
    else if(code == 404 || code == 405)
    {
        response.put("text", "API address incorrect (" + code + "). Use your Render service URL ending in /chat.");
    }
    else if(code == 502 || code == 504)
    {
        response.put("text", "Render service is starting or unavailable (" + code + "). Open /health, wait for it to respond, then retry.");
    }
    else
    {
        try
        {
            body = result.get("responseText").toString().toMap();
            if(body.get("text") != null)
            {
                response.put("text", body.get("text"));
            }
            else if(body.get("detail") != null)
            {
                response.put("text", "Research API error (" + code + "): " + body.get("detail").toString());
            }
            else
            {
                response.put("text", "Unexpected API response (" + code + "). Check the Render deployment and /chat URL.");
            }
        }
        catch (parse_error)
        {
            response.put("text", "Research API returned a non-JSON response (" + code + "). Check Render Logs and confirm the /chat URL.");
        }
    }
}
catch (e)
{
    response.put("text", "Research service did not respond. Please try again shortly.");
}
return response;
